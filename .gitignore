# ==============================================================================
# .gitignore — Blog Automation System
# ==============================================================================

# ── Ambiente Virtual & Dependências Locais ────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Variáveis de Ambiente e Segredos ──────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Python & Compilação ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
.installed.cfg
*.egg
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Logs & Arquivos Temporários ───────────────────────────────────────────────
*.log
logs/
*.tmp
*.temp
tmp/
temp/

# ── Saídas Geradas pelo Sistema (Locais) ───────────────────────────────────────
pdf-output/

# ── Configurações de IDEs e Editores ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Sistema Operacional ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
